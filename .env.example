# =============================================================================
# CONSEJO DE HONOR FVF — Variables de entorno
# Copiar a .env y completar. NUNCA commitear el archivo .env real.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# La aplicacion usa DOS conexiones distintas:
#
#   DATABASE_URL -> la app en caliente. En la nube, la CON POOLER
#                   (Neon: "...-pooler...", Supabase: ":6543").
#   DIRECT_URL   -> sin pooler. Prisma la usa solo para migraciones, db push y
#                   studio. En la nube es el endpoint DIRECTO.
#
# LOCAL (instalado sin admin, ver docs/BASE-DE-DATOS.md):
DATABASE_URL="postgresql://cdh:cdh_dev_2026@localhost:5432/cdh_plataforma?schema=public"
DIRECT_URL="postgresql://cdh:cdh_dev_2026@localhost:5432/cdh_plataforma?schema=public"

# NUBE - Neon (ejemplo; reemplazar por las suyas):
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# NUBE - Supabase (pooler en el puerto 6543, directo en 5432):
#   DATABASE_URL="postgresql://postgres.xxxx:PASS@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
#   DIRECT_URL="postgresql://postgres.xxxx:PASS@aws-0-region.supabase.com:5432/postgres?sslmode=require"
#
# NUBE - Railway / Render / cualquier Postgres gestionado:
#   DATABASE_URL="postgresql://USER:PASS@host:5432/db?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASS@host:5432/db?sslmode=require"
#
# `sslmode=require` es obligatorio en la nube: casi ningun proveedor acepta
# conexiones sin TLS. En produccion conviene anadir `&statement_cache_size=0`
# si el pooler es PgBouncer en modo transaccion.

# --- Aplicación --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Consejo de Honor FVF"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Autenticación -----------------------------------------------------------
# Clave con la que se firman los tokens de sesión. Generar con:
#   openssl rand -base64 32
AUTH_SECRET="CAMBIAR_EN_PRODUCCION_CON_OPENSSL_RAND_BASE64_32"

# Cuenta de acceso inicial. La crea `npm run db:seed:usuario`.
# No forma parte del repositorio: `.env` está en `.gitignore`.
ADMIN_EMAIL="julio.osorio@fvf.com.ve"
ADMIN_PASSWORD="FVF123456*"
ADMIN_NOMBRE="Julio Osorio"

# --- Google Sheets: modo 1 (recomendado) Service Account --------------------
# 1) Crear el proyecto en https://console.cloud.google.com
# 2) Habilitar Google Sheets API
# 3) Crear Service Account y descargar el JSON
# 4) Compartir cada hoja con el correo: <service-account>@<project>.iam.gserviceaccount.com
#    con permiso de LECTOR
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# --- Google Drive: PDFs de expedientes ---------------------------------------
# Comparte la carpeta con la cuenta de servicio como lector. El nombre del PDF
# debe incluir el expediente/año (por ejemplo EXP-012-2025.pdf) para asociarlo.
GOOGLE_DRIVE_EXPEDIENTES_FOLDER_ID=""
# Reutiliza el correo y la clave privada de la cuenta de servicio de Sheets.

# --- Google Sheets: modo 2 (sin credenciales, solo lectura) -----------------
# Publicar cada hoja: Archivo > Compartir > Publicar en la web > CSV
# Pegar aquí el enlace completo con gid y output=csv.
GOOGLE_SHEETS_COMPETENCIAS_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vTNosjqXFHJudTeOffMON_e-W0oslKa1oaR50-SzFIhDbD5X24T7j-FxrV9z4NsQA/pub?gid=1639745222&single=true&output=csv"
GOOGLE_SHEETS_COMPETENCIAS_GID="1639745222"

# El CUADRO DE EXPEDIENTES no esta publicado; se accede por /export?format=csv
# siempre que el libro este compartido como "cualquier persona con el enlace".
GOOGLE_SHEETS_EXPEDIENTES_DOC_ID="1Njhrbdf32k4TfAAaTh-gVYH6BaVUZ8yMh5vUs3h7PgE"
GOOGLE_SHEETS_EXPEDIENTES_GID="1385768914"
GOOGLE_SHEETS_EXPEDIENTES_CSV_URL="https://docs.google.com/spreadsheets/d/1Njhrbdf32k4TfAAaTh-gVYH6BaVUZ8yMh5vUs3h7PgE/export?format=csv&gid=1385768914"

# --- OCR / Extracción de actas ----------------------------------------------
# Agente jurídico (análisis y embeddings RAG)
GEMINI_API_KEY=""

# Claude (PDF/Word con capa de texto)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-5"

# Google Document AI (PDF escaneado / imagen)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_DOCUMENT_AI_PROCESSOR=""

# --- Almacenamiento local de documentos --------------------------------------
# En producción debe ser un volumen privado y persistente, nunca una carpeta pública.
CDH_ARCHIVOS_DIR="./storage/expedientes"
STORAGE_PATH="./storage"
STORAGE_MAX_MB="20"
