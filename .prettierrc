{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 96,
  "tabWidth": 2,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/styles/globals.css",
  "overrides": [
    {
      "files": "*.prisma",
      "options": { "printWidth": 100, "tabWidth": 2 }
    }
  ]
}
