enum EstadoReportePago {
  PENDIENTE_VERIFICACION  // Enviado por el club/afectado, en revisiÃ³n por AdministraciÃ³n
  VERIFICADO_CONCILIADO   // Aprobado por AdministraciÃ³n y Consejo de Honor
  RECHAZADO_INCORRECTO    // Comprobante invÃ¡lido o monto incompleto
}

model ReportePagoAfectado {
  id                    Int                     @id @default(autoincrement())
  expedienteId          Int                     @map("expediente_id")
  expediente            ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  sancionId             Int?                    @map("sancion_id")
  sancion               SancionExpediente?      @relation(fields: [sancionId], references: [id], onDelete: SetNull)
  
  // Datos aportados por el Afectado
  entidadEmisor         String                  @map("entidad_emisor")         // Banco o instituciÃ³n de origen
  referenciaBancaria    String                  @map("referencia_bancaria")    // NÂ° de transferencia o depÃ³sito
  montoPagadoUsd        Decimal                 @map("monto_pagado_usd")       // Monto reportado en USD
  montoPagadoUcfvf      Decimal                 @map("monto_pagado_ucfvf")     // Equivalente en UCFVF
  fechaPago             DateTime                @map("fecha_pago")
  comprobanteUrl        String                  @map("comprobante_url")        // URL en Supabase Storage
  observacionesAfectado String?                 @map("observaciones_afectado")

  // Estado y ConciliaciÃ³n Administrativa
  estado                EstadoReportePago       @default(PENDIENTE_VERIFICACION)
  conciliadoPor         String?                 @map("conciliado_por")         // Usuario de AdministraciÃ³n
  fechaConciliacion     DateTime?               @map("fecha_conciliacion")
  observacionAdmin      String?                 @map("observacion_admin")

  // Trazabilidad de notificaciones a otras unidades
  notificadoAdmin       Boolean                 @default(true) @map("notificado_admin")
  notificadoLicencias   Boolean                 @default(false) @map("notificado_licencias")
  notificadoCdh         Boolean                 @default(true) @map("notificado_cdh")

  creadoEn              DateTime                @default(now()) @map("creado_en")
  actualizadoEn         DateTime                @updatedAt @map("actualizado_en")

  @@index([expedienteId, estado])
  @@map("reporte_pago_afectado")
}
