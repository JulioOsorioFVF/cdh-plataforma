  autoEntrada String? @map("auto_entrada")
  fechaAutoEntrada DateTime?        @db.Date @map("fecha_auto_entrada")
  /// `Equipos`: texto libre "A Vs. B" (238 de 563 filas lo tienen).
  equipos String? @map("equipos")
  /// `TrÃ¡mite`
  tramiteRaw String? @map("tramite_raw")
  /// `Modalidad`: Fisico | Mixto | Digital
  modalidad String? @map("modalidad")
  /// `ASIGNADO`: jueces responsables, separados por coma.
  asignado String? @map("asignado")
  fechaAsignacion DateTime?        @db.Date @map("fecha_asignacion")
  fechaSeguimiento DateTime?        @db.Date @map("fecha_seguimiento")
  /// `ALERTA`
  alerta String? @map("alerta")
  /// `STATUS` tal como viene de la hoja.
  estatus String @map("estatus")
  estado EstadoExpediente @default(RECIBIDO) @map("estado")

  fechaRecepcion DateTime? @db.Date @map("fecha_recepcion")
  fechaResolucion DateTime? @db.Date @map("fecha_resolucion")
  diasTramitacion Int? @map("dias_tramitacion")
  tipo String? @map("tipo")
  notas String? @map("notas")

  /// `NÂº Auto y/o DecisiÃ³n`: codigo del auto/resolucion principal.
  numeroDecision String? @map("numero_decision")
  /// `SanciÃ³n`: texto libre de la resolucion.
  sancionRaw String? @map("sancion_raw")
  /// `Sancionado`: nombre tal como viene en la resolucion.
  sancionadoRaw String? @map("sancionado_raw")
  multaUc Decimal? @db.Decimal(18, 4) @map("multa_uc")
  multaUsd Decimal? @db.Decimal(18, 2) @map("multa_usd")
  /// `CUMPLIMIENTO DE LA DECISIÃ“N`: SI | NO | FALTA PAGO DE LA MULTA.
  cumplimientoDecision String? @map("cumplimiento_decision")
  /// `MOTIVO` (columna 35): motivo del incumplimiento o del estado de pago.
  motivoCumplimiento String? @map("motivo_cumplimiento")
  archivoOrigen String? @map("archivo_origen")
  filaOrigen Int? @map("fila_origen")
  hashOrigen String?  @unique @map("hash_origen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fechaId Int? @map("fecha_id")
  fecha       dim_fecha?     @relation(fields: [fechaId], references: [id], onDelete: SetNull)
  torneoId Int? @map("torneo_id")
  torneo      dim_torneo?    @relation(fields: [torneoId], references: [id], onDelete: SetNull)
  categoriaId Int? @map("categoria_id")
  categoria   dim_categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  creadoPorId Int? @map("creado_por_id")

  creadoPor usuario?                     @relation("expediente_creado_por", fields: [creadoPorId], references: [id], onDelete: SetNull)
  movimientos fact_expediente_movimiento[]
  partes      fact_expediente_parte[]
  partidos    fact_expediente_partido[]
  sanciones   fact_sancion_expediente[]
  documentos  expediente_documento[]
  multas      fact_admin_multa[]

  @@unique([anio, numero])
  @@index([anio, estado])
  @@index([fechaId])
  @@index([torneoId, categoriaId])
  @@index([estatus])
  @@index([tramiteRaw])
  @@map("fact_expediente")
}

