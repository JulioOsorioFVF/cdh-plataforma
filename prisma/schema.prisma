}

// =============================================================================
// CAPA DE INGESTA (staging)
//
// Zona de aterrizaje intermedia entre la fuente (Google Sheets o un archivo) y
// las tablas de hechos. Cada corrida crea un LOTE; cada fila del CSV deja una
// huella (`hash`) y, si tuvo problemas, el contenido crudo para poder
// diagnosticarla. Las filas limpias solo guardan la huella: el lote es el
// contrato de idempotencia, no una copia de los datos.
// =============================================================================

enum EstadoFila {
  VALIDA
  ADVERTENCIA
  RECHAZADA
  CARGADA
}

model stg_lote {
  id     Int    @id @default(autoincrement()) @map("id")
  /// COMPETENCIAS | EXPEDIENTES
  documento String @map("documento")
  /// GOOGLE_SHEETS | ARCHIVO
  fuente String @map("fuente")
  url    String? @map("url")
  /// Nombre del archivo cuando la fuente es una carga manual.
  archivo String? @map("archivo")
  /// sha256 del contenido: dos corridas del mismo archivo son el mismo lote.
  huella String? @map("huella")
  separador String? @map("separador")
  encabezados Json? @map("encabezados")
  /// false si el archivo no trae todas las columnas del contrato.
  esquemaOk Boolean @default(true) @map("esquema_ok")
  columnasFaltantes Json? @map("columnas_faltantes")

  filasLeidas      Int @default(0) @map("filas_leidas")
  filasValidas     Int @default(0) @map("filas_validas")
  filasAdvertencia Int @default(0) @map("filas_advertencia")
  filasRechazadas  Int @default(0) @map("filas_rechazadas")
  filasCargadas    Int @default(0) @map("filas_cargadas")
  filasOmitidas    Int @default(0) @map("filas_omitidas")

  /// Perfil de columnas calculado durante la estandarizacion (nulos, distintos, top).
  perfil        Json? @map("perfil")
  /// Version del contrato de estandarizacion usado, para reproducir un lote viejo.
  motorVersion  String @default("1") @map("motor_version")
  estado        EstadoIngesta @default(PENDIENTE) @map("estado")
  /// RECIBIDO | ESTANDARIZADO | CARGANDO | TERMINADO | ERROR
  fase          String @default("RECIBIDO") @map("fase")
  mensaje       String? @map("mensaje")
  duracionMs    Int? @map("duracion_ms")

  usuarioId    Int? @map("usuario_id")
  ingestaLogId Int? @map("ingesta_log_id")

  iniciadaEn   DateTime  @default(now()) @map("iniciada_en")
  finalizadaEn DateTime? @map("finalizada_en")

  usuario usuario?   @relation("lotes_ingesta", fields: [usuarioId], references: [id], onDelete: SetNull)
  filas   stg_fila[]

  @@index([documento, iniciadaEn])
  @@index([estado])
  @@map("stg_lote")
}

model stg_fila {
  id         BigInt     @id @default(autoincrement()) @map("id")
  loteId     Int        @map("lote_id")
  /// Numero de fila del CSV (1 = primera fila de datos, el encabezado no cuenta).
  numeroFila Int        @map("numero_fila")
  /// Huella del contenido normalizado: identifica la fila aunque cambie el archivo.
  hash       String     @map("hash")
  estado     EstadoFila @default(VALIDA) @map("estado")
  /// Motivos que impiden cargar la fila (codigo + detalle).
  errores    Json?      @map("errores")
  /// Observaciones que no impiden la carga.
  avisos     Json?      @map("avisos")
  /// Contenido original, solo en filas con problemas: sirve para diagnosticar.
  crudo      Json?      @map("crudo")

  lote stg_lote @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@index([loteId, estado])
  @@index([hash])
  @@map("stg_fila")
}

