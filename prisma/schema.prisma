/// DefiniciÃ³n de KPI: fÃ³rmula declarativa + meta + polaridad.
model kpi_definicion {
  id Int          @id @default(autoincrement()) @map("id")
  planId Int @map("plan_id")
  pilarId Int? @map("pilar_id")
  codigo String @map("codigo")
  nombre String @map("nombre")
  descripcion String? @map("descripcion")
  /// FÃ³rmula declarativa en JSON. Ejemplo:
  /// { "tipo": "PROPORCION", "numerador": { "agg": "count",
  ///   "filtros": { "tipoDecision": "SUSPENSION" } },
  ///   "denominador": { "agg": "count", "filtros": {} } }
  formula Json @map("formula")
  /// % | ABS | USD | PARTIDOS | DIAS | U.C.
  unidad String @map("unidad")
  meta Decimal?     @db.Decimal(18, 4) @map("meta")
  polaridad PolaridadKpi @default(MAYOR_MEJOR) @map("polaridad")
  /// DIARIA | SEMANAL | MENSUAL | TRIMESTRAL | ANUAL
  periodicidad String       @default("MENSUAL") @map("periodicidad")
  activa Boolean      @default(true) @map("activa")
  orden Int          @default(0) @map("orden")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  plan       plan_accion?   @relation(fields: [planId], references: [id], onDelete: Cascade)
  pilar pilar?         @relation(fields: [pilarId], references: [id], onDelete: Cascade)
  mediciones kpi_medicion[]

  @@unique([planId, codigo])
  @@index([pilarId])
  @@map("kpi_definicion")
}

/// Snapshot de un KPI por perÃ­odo, para evoluciÃ³n histÃ³rica.
model kpi_medicion {
  id Int      @id @default(autoincrement()) @map("id")
  kpiId Int @map("kpi_id")
  /// Primer dÃ­a del perÃ­odo.
  periodo DateTime @db.Date @map("periodo")
  /// DIA | SEMANA | MES | TRIMESTRE | ANIO
  granularidad String @map("granularidad")
  valor Decimal  @db.Decimal(18, 4) @map("valor")
  meta Decimal? @db.Decimal(18, 4) @map("meta")
  cumplio Boolean? @map("cumplio")
  calculadoEn DateTime @default(now()) @map("calculado_en")

  kpi kpi_definicion @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, periodo, granularidad])
  @@index([periodo])
  @@map("kpi_medicion")
}

