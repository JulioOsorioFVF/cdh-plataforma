// MÃ“DULO DE TRÃMITE INTEGRAL DE EXPEDIENTES DISCIPLINARIOS (SUPABASE)
// ============================================================================

enum EtapaProcesal {
  ENTRADA                  // RecepciÃ³n en SecretarÃ­a / Mesa de Partes
  OFICIOS_PREVIOS          // Solicitud de informes a Competiciones / COMET / CNA
  AUTO_DE_INICIO           // AdmisiÃ³n o Inadmisibilidad (Art. 169 / 170 RDFVF)
  RECEPCION_RECAUDOS       // Lapso probatorio y descargos de las partes
  LAPSO_RESOLUCION         // SustanciaciÃ³n cerrada, en manos del Juez Ãšnico / Ponente
  PROYECTO_RESOLUCION      // Borrador redactado por Especialista Legal para reuniÃ³n
  PUBLICACION_NOTIFICACION // Firmado en reuniÃ³n ordinaria/extraordinaria y notificado
  EJECUCION_CUMPLIMIENTO   // Seguimiento de pago de multas (UCFVF) y cÃ³mputo de partidos
  ARCHIVADO                // Caso cerrado con solvencia o resoluciÃ³n firme
}

enum EstadoTramite {
  EN_INSTRUCCION
  DECIDIDO
  INADMISIBLE
  SOBRESEIDO
  EN_RECURSO
  EN_TAS
}

model ExpedienteDisciplinario {
  id                     Int           @id @default(autoincrement())
  codigoExpediente       String        @unique @map("codigo_expediente") // Ej: "EXP-049-2026"
  numeroCorrelativo      Int           @map("numero_correlativo")        // Col A Sheet: 49
  anio                   Int                                             // Col B Sheet: 2026
  modalidad              String        @default("Digital")               // Digital | FÃ­sico
  viaIngreso             String        @map("via_ingreso")               // PROTESTA | DENUNCIA | INFORME_ARBITRAL | INFORME_DELEGADO | OFICIO_INTEGRIDAD | REMISION_ELECTORAL

  // ClasificaciÃ³n Deportiva y Partes
  torneoCategoria        String        @map("torneo_categoria")          // Liga FUTVE, Futsal 1, Junior, etc.
  jornada                String?
  partido                String?                                         // Equipos involucrados
  motivoPrincipal        String        @map("motivo_principal")          // AlineaciÃ³n indebida, Hechos violentos, Deuda, etc.
  asuntoDetallado        String        @map("asunto_detallado")
  parteDemandante        String?       @map("parte_demandante")
  parteDemandada         String        @map("parte_demandada")

  // Control de Admisibilidad (Filtro PedagÃ³gico Art. 169 y 170 RDFVF)
  requiereCaucion        Boolean       @default(false) @map("requiere_caucion")
  caucionVerificada      Boolean       @default(false) @map("caucion_verificada")
  articulosInvocados     Boolean       @default(true)  @map("articulos_invocados")
  enLapsoReglamentario   Boolean       @default(true)  @map("en_lapso_reglamentario")
  causaInadmisibilidad   String?       @map("causa_inadmisibilidad")

  // Estado Procesal y AsignaciÃ³n PMO (Sustituye Trello + Columnas M-Q Sheet)
  etapaActual            EtapaProcesal @default(ENTRADA) @map("etapa_actual")
  estadoTramite          EstadoTramite @default(EN_INSTRUCCION) @map("estado_tramite")
  juezUnicoAsignado      String?       @map("juez_unico_asignado")
  especialistaAsignado   String?       @map("especialista_asignado")
  analistaSeguimiento    String?       @map("analista_seguimiento")
  prioridadSla           String        @default("NORMAL") @map("prioridad_sla") // URGENTE_24H | ALTA | NORMAL
  fechaApertura          DateTime      @default(now()) @map("fecha_apertura")
  fechaAsignacion        DateTime?     @map("fecha_asignacion")
  fechaVencimientoSla    DateTime?     @map("fecha_vencimiento_sla")
  fechaCierreDecision    DateTime?     @map("fecha_cierre_decision")

  // Relaciones del TrÃ¡mite Integral
  actuaciones            ActuacionProcesal[]
  sanciones              SancionExpediente[]
  recursos               RecursoExpediente[]
  documentos             DocumentoExpediente[]
  reportesPago           ReportePagoAfectado[]

  creadoEn               DateTime      @default(now()) @map("creado_en")
  actualizadoEn          DateTime      @updatedAt @map("actualizado_en")

  @@index([anio, estadoTramite])
  @@index([etapaActual, especialistaAsignado])
  @@index([torneoCategoria])
  @@map("expediente_disciplinario")
}

// Registra las 233 "Referencias" (antes Autos), Oficios, Cierres de InstrucciÃ³n y Decisiones
model ActuacionProcesal {
  id                  Int                     @id @default(autoincrement())
  expedienteId        Int                     @map("expediente_id")
  expediente          ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  tipoActuacion       String                  @map("tipo_actuacion") // REFERENCIA | AUTO_INICIO | OFICIO_COMET | DECISION_1RA_INSTANCIA | ACTA_REUNION
  numeroActuacion     String?                 @map("numero_actuacion") // Ej: "Ref. 085/2026" o "Res. 046/2026"
  fechaActuacion      DateTime                @default(now()) @map("fecha_actuacion")
  etapaDestino        EtapaProcesal           @map("etapa_destino")
  resumenDispositivo  String                  @map("resumen_dispositivo")
  organosNotificados  String[]                @map("organos_notificados") // ["COMET", "LICENCIA_CLUBES", "CNA", "ADMINISTRACION"]
  creadoPor           String                  @map("creado_por")
  archivoUrlSupabase  String?                 @map("archivo_url_supabase")

  @@index([expedienteId, fechaActuacion])
  @@map("actuacion_procesal")
}

// Permite mÃºltiples sancionados y control financiero exacto (UCFVF / USD / Cumplimiento)
model SancionExpediente {
  id                     Int                     @id @default(autoincrement())
  expedienteId           Int                     @map("expediente_id")
  expediente             ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  reportesPago           ReportePagoAfectado[]
  sujetoSancionado       String                  @map("sujeto_sancionado")
  tipoSujeto             String                  @map("tipo_sujeto") // CLUB | JUGADOR | CUERPO_TECNICO | DIRIGENTE | ARBITRO
  articulosAplicados     String                  @map("articulos_aplicados") // Ej: "Art. 77.2 y 108 RDFVF"
  tipoSancionDeportiva   String?                 @map("tipo_sancion_deportiva") // SUSPENSION_PARTIDOS | SUSPENSION_TIEMPO | PERDIDA_PUNTOS | DEDUCCION | ADVERTENCIA
  cantidadPartidosMeses  String?                 @map("cantidad_partidos_meses")
  multaUcfvf             Decimal                 @default(0) @map("multa_ucfvf")
  tasaUcfvfUsd           Decimal                 @default(3.0) @map("tasa_ucfvf_usd")
  multaUsd               Decimal                 @default(0) @map("multa_usd")
  estadoCumplimiento     String                  @default("PENDIENTE") @map("estado_cumplimiento") // PENDIENTE | PAGADO_CUMPLIDO | EN_MORA_BLOQUEADO | EXONERADO_PARCIAL
  referenciaPago         String?                 @map("referencia_pago") // Ej: "Transf. #00094474 Bco. Venezuela"
  fechaCumplimiento      DateTime?               @map("fecha_cumplimiento")
  observacionEjecucion   String?                 @map("observacion_ejecucion")

  @@index([expedienteId, estadoCumplimiento])
  @@map("sancion_expediente")
}

// Gestiona Reconsideraciones, Apelaciones y casos ante el TAS
model RecursoExpediente {
  id                  Int                     @id @default(autoincrement())
  expedienteId        Int                     @map("expediente_id")
  expediente          ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  tipoRecurso         String                  @map("tipo_recurso") // RECONSIDERACION | APELACION | TAS
  fechaInterposicion  DateTime                @map("fecha_interposicion")
  numeroResolucion    String?                 @map("numero_resolucion")
  fechaResolucion     DateTime?               @map("fecha_resolucion")
  resultadoRecurso    String?                 @map("resultado_recurso") // SIN_LUGAR_RATIFICADO | CON_LUGAR | PARCIALMENTE_CON_LUGAR | INADMISIBLE
  detalleDecision     String?                 @map("detalle_decision")

  @@map("recurso_expediente")
}

// Almacenamiento de evidencias en Supabase Storage
model DocumentoExpediente {
  id             Int                     @id @default(autoincrement())
  expedienteId   Int                     @map("expediente_id")
  expediente     ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  nombreArchivo  String                  @map("nombre_archivo")
  categoria      String                  // DENUNCIA | INFORME_ARBITRO | INFORME_DELEGADO | VIDEO_PRUEBA | CAUCION | REFERENCIA_PDF | DECISION_PDF
  bucketPath     String                  @map("bucket_path") // Ruta en Supabase Storage
  subidoPor      String                  @map("subido_por")
  creadoEn       DateTime                @default(now()) @map("creado_en")

  @@map("documento_expediente")
}
