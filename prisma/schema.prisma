// =============================================================================
// CONSEJO DE HONOR FVF â€” Esquema de datos
// Big Data Disciplinaria del FÃºtbol
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexion de la aplicacion. En la nube debe apuntar al endpoint CON POOLER
  // (Neon/Supabase lo llaman "pooled connection"), porque las conexiones
  // directas no escalan y los proveedores las limitan.
  url = env("DATABASE_URL")
  // Conexion DIRECTA, sin pooler. Prisma la usa automaticamente para
  // `migrate`, `db push` y `studio`: las migraciones necesitan DDL y una
  // sesion estable, y sobre un pooler fallan. En local ambas son iguales.
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMERACIONES
// =============================================================================

enum PolaridadKpi {
  MAYOR_MEJOR
  MENOR_MEJOR
  IGUAL_META
}

enum EstadoObjetivo {
  NO_INICIADO
  EN_CURSO
  ALCANZADO
  SUPERADO
  DETENIDO
}

enum EstadoExpediente {
  RECIBIDO
  EN_ESTUDIO
  RESUELTO
  NOTIFICADO
  EN_RECURSO
  ARCHIVADO
  DESESTIMADO
  REMITIDO
}

enum EstadoIngesta {
  PENDIENTE
  PROCESANDO
  VALIDADO
  CARGADO
  CON_ERRORES
  DESCARTADO
}

enum EstadoOcr {
  PENDIENTE
  PROCESANDO
  REVISADO
  APROBADO
  RECHAZADO
  ERROR
}

enum TipoParte {
  JUGADOR
  CUERPO_TECNICO
  CLUB
  COMISION
  LIGA
  ORGANIZADOR
  FVF
  OTRO
}

enum TipoMovimientoExpediente {
  AUTO
  PROVIDENCIA
  RESOLUCION
  SENTENCIA
  AUTO_ADMISORIO
  /// Recurso de reconsideracion ("Ejercieron Reconsideracion" / "FECHA R.R.").
  RECONSIDERACION
  /// Segunda instancia: apelacion ante la Comision de Control de Entrenamiento.
  SEGUNDA_INSTANCIA
  REMISION
  NOTIFICACION
  CONSIGNACION
  ARIETE
  OTRO
}

enum RolHabitual {
  JUGADOR
  DIRECTOR_TECNICO
  ASISTENTE_TECNICO
  PREPARADOR_FISICO
  DELEGADO
  ARBITRO
  ASISTENTE_ARBITRO
  MEDICO
  FISIOTERAPEUTA
  UTILLERO
  CAMILLERO
  DIRIGENTE
  OTRO
}

enum Catalogo {
  TIPO_DE_SANCIONADO
  TIPO
  MOTIVO
  TIPO_DE_INFRACCION
  INCIDENCIA_LICENCIA
  DETALLE_INCIDENCIA
  FUENTE_NORMA
  TIPO_DE_REGISTRO
  SALDO
}

// =============================================================================
// DIMENSIONES
// =============================================================================

/// Calendario fiscal-deportivo. Se puebla de forma incremental.
model dim_fecha {
  id Int      @id @default(autoincrement()) @map("id")
  fecha DateTime @unique @db.Date @map("fecha")
  anio Int @map("anio")
  trimestre Int @map("trimestre")
  mes Int @map("mes")
  dia Int @map("dia")
  semanaIso Int @map("semana_iso")
  diaSemana Int @map("dia_semana")
  nombreMes String @map("nombre_mes")
  nombreTrimestre String @map("nombre_trimestre")
  esFinSemana Boolean  @default(false) @map("es_fin_semana")
  esFeriado Boolean  @default(false) @map("es_feriado")

  partidos   fact_partido[]
  sanciones  fact_sancion[]
  incidentes fact_expediente[]
  multas     fact_admin_multa[]

  @@index([anio, mes])
  @@index([anio, trimestre])
  @@map("dim_fecha")
}

/// Torneo. Columna `TORNEO` de la data.
model dim_torneo {
  id Int      @id @default(autoincrement()) @map("id")
  codigo String?  @unique @map("codigo")
  nombre String   @unique @map("nombre")
  temporada Int? @map("temporada")
  temporadaSlug String? @map("temporada_slug")
  vigente Boolean  @default(true) @map("vigente")
  notas String? @map("notas")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categorias dim_torneo_categoria[]
  fases      dim_fase[]
  rondas     dim_ronda[]
  jornadas   dim_jornada[]
  partidos   fact_partido[]
  sanciones  fact_sancion[]
  incidentes fact_expediente[]
  multas     fact_admin_multa[]

  @@index([temporada])
  @@map("dim_torneo")
}

model dim_torneo_categoria {
  torneoId Int @map("torneo_id")
  categoriaId Int @map("categoria_id")

  torneo    dim_torneo    @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  categoria dim_categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([torneoId, categoriaId])
  @@index([categoriaId])
  @@map("dim_torneo_categoria")
}

/// CategorÃ­a: SUB-18, SUB-21, FUTSAL, FEMENINO, PROFESIONAL, RESERVA...
model dim_categoria {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String? @unique @map("codigo")
  nombre String  @unique @map("nombre")
  orden Int     @default(0) @map("orden")
  subdivision String? @map("subdivision")
  vigente Boolean @default(true) @map("vigente")

  conductores dim_categoria_conductor[]
  torneos     dim_torneo_categoria[]
  partidos    fact_partido[]
  sanciones   fact_sancion[]
  incidentes  fact_expediente[]
  clubes      dim_club_categoria[]
  multas      fact_admin_multa[]

  @@index([orden])
  @@map("dim_categoria")
}

model dim_fase {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String? @map("codigo")
  nombre String @map("nombre")
  orden Int     @default(0) @map("orden")
  temporada Int? @map("temporada")

  torneoId Int @map("torneo_id")
  torneo   dim_torneo @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  partidos  fact_partido[]
  sanciones fact_sancion[]

  @@unique([torneoId, nombre])
  @@index([nombre])
  @@index([orden])
  @@map("dim_fase")
}

model dim_ronda {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String? @map("codigo")
  nombre String @map("nombre")
  orden Int     @default(0) @map("orden")
  temporada Int? @map("temporada")

  torneoId Int @map("torneo_id")
  torneo   dim_torneo @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  partidos  fact_partido[]
  sanciones fact_sancion[]

  @@unique([torneoId, nombre])
  @@index([nombre])
  @@map("dim_ronda")
}

model dim_jornada {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String? @map("codigo")
  nombre String @map("nombre")
  numero Int? @map("numero")
  orden Int     @default(0) @map("orden")
  temporada Int? @map("temporada")

  torneoId Int @map("torneo_id")
  torneo   dim_torneo @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  partidos  fact_partido[]
  sanciones fact_sancion[]

  @@unique([torneoId, nombre])
  @@index([numero])
  @@index([nombre])
  @@map("dim_jornada")
}

/// Club. `nombre` es la clave natural; `nombreNormalizado` para deduplicar.
model dim_club {
  id Int      @id @default(autoincrement()) @map("id")
  codigo String?  @unique @map("codigo")
  nombre String   @unique @map("nombre")
  nombreNormalizado String   @unique @map("nombre_normalizado")
  nombreCorto String? @map("nombre_corto")
  alias String[] @map("alias")
  grupo String? @map("grupo")
  liga String? @map("liga")
  vigente Boolean  @default(true) @map("vigente")
  notas String? @map("notas")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categorias        dim_club_categoria[]
  partidosLocal     fact_partido[]          @relation("partido_local")
  partidosVisitante fact_partido[]          @relation("partido_visitante")
  sanciones         fact_sancion[]
  personas          dim_persona[]
  incidentesParte1  fact_expediente_parte[] @relation("exp_parte1_club")
  incidentesParte2  fact_expediente_parte[] @relation("exp_parte2_club")
  multas            fact_admin_multa[]

  @@index([grupo])
  @@map("dim_club")
}

model dim_club_categoria {
  clubId Int @map("club_id")
  categoriaId Int @map("categoria_id")
  temporada Int? @map("temporada")
  grupo String? @map("grupo")
  vigente Boolean @default(true) @map("vigente")

  club      dim_club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categoria dim_categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([clubId, categoriaId])
  @@index([categoriaId])
  @@map("dim_club_categoria")
}

/// Un club puede tener varios conductores (Juez Ãšnico, Delegado...).
model dim_categoria_conductor {
  id Int         @id @default(autoincrement()) @map("id")
  categoriaId Int @map("categoria_id")
  conductorId Int @map("conductor_id")
  rol RolHabitual @map("rol")
  temporada Int? @map("temporada")
  notas String? @map("notas")

  categoria dim_categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  conductor dim_persona   @relation(fields: [conductorId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, conductorId, rol, temporada])
  @@index([conductorId])
  @@map("dim_categoria_conductor")
}

/// Persona: jugador, cuerpo tÃ©cnico, Ã¡rbitro, etc. Clave natural: cÃ©dula.
model dim_persona {
  id Int          @id @default(autoincrement()) @map("id")
  cedula String       @unique @map("cedula")
  nombres String? @map("nombres")
  apellidos String? @map("apellidos")
  nombreCompleto String @map("nombre_completo")
  nombreNormalizado String       @unique @map("nombre_normalizado")
  rolHabitual RolHabitual? @map("rol_habitual")
  rolTexto String? @map("rol_texto")
  clubId Int? @map("club_id")
  email String? @map("email")
  telefono String? @map("telefono")
  activo Boolean      @default(true) @map("activo")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  club             dim_club?                 @relation(fields: [clubId], references: [id], onDelete: SetNull)
  conduce          dim_categoria_conductor[]
  sanciones        fact_sancion[]
  incidentesParte1 fact_expediente_parte[]   @relation("exp_parte1_persona")
  incidentesParte2 fact_expediente_parte[]   @relation("exp_parte2_persona")

  @@index([nombreNormalizado])
  @@index([rolHabitual])
  @@index([clubId])
  @@map("dim_persona")
}

model dim_tipo_sancionado {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String  @unique @map("codigo")
  nombre String  @unique @map("nombre")
  orden Int     @default(0) @map("orden")
  aplicaAPersona Boolean @default(true) @map("aplica_a_persona")
  aplicaAClub Boolean @default(true) @map("aplica_a_club")

  sanciones fact_sancion[]

  @@index([orden])
  @@map("dim_tipo_sancionado")
}

model dim_tipo_decision {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String  @unique @map("codigo")
  nombre String  @unique @map("nombre")
  orden Int     @default(0) @map("orden")
  aplicaAPersona Boolean @default(true) @map("aplica_a_persona")
  aplicaAClub Boolean @default(true) @map("aplica_a_club")
  aplicaAComision Boolean @default(true) @map("aplica_a_comision")
  esMulta Boolean @default(false) @map("es_multa")
  esSuspension Boolean @default(false) @map("es_suspension")

  sanciones fact_sancion[]
  motivos   dim_motivo[]

  @@index([orden])
  @@map("dim_tipo_decision")
}

model dim_motivo {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String? @unique @map("codigo")
  nombre String  @unique @map("nombre")
  tipoDecisionId Int? @map("tipo_decision_id")
  orden Int     @default(0) @map("orden")
  requiereArticulo Boolean @default(true) @map("requiere_articulo")
  vigente Boolean @default(true) @map("vigente")

  tipoDecision dim_tipo_decision? @relation(fields: [tipoDecisionId], references: [id], onDelete: SetNull)
  sanciones    fact_sancion[]

  @@index([orden])
  @@map("dim_motivo")
}

model dim_tipo_infraccion {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String? @unique @map("codigo")
  nombre String  @unique @map("nombre")
  orden Int     @default(0) @map("orden")
  ambito String? @map("ambito")

  observaciones dim_observacion[]
  sanciones     fact_sancion[]

  @@index([orden])
  @@map("dim_tipo_infraccion")
}

model dim_observacion {
  id Int     @id @default(autoincrement()) @map("id")
  texto String @map("texto")
  textoNormalizado String  @unique @map("texto_normalizado")
  tipoInfraccionId Int? @map("tipo_infraccion_id")
  vigente Boolean @default(true) @map("vigente")

  tipoInfraccion dim_tipo_infraccion? @relation(fields: [tipoInfraccionId], references: [id], onDelete: SetNull)
  sanciones      fact_sancion[]

  @@index([tipoInfraccionId])
  @@map("dim_observacion")
}

/// Norma: RD, NR, RGC, E-FVF, CD-FIFA, LOD, RP1-LOD...
model dim_norma {
  id Int      @id @default(autoincrement()) @map("id")
  codigo String   @unique @map("codigo")
  nombre String @map("nombre")
  descripcion String? @map("descripcion")
  documentos String[] @map("documentos")
  vigente Boolean  @default(true) @map("vigente")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articulos     dim_articulo[]
  sanciones     fact_sancion[]
  normasCitadas fact_sancion_norma[]

  @@map("dim_norma")
}

/// ArtÃ­culo de una norma. Grano: un artÃ­culo por fila.
model dim_articulo {
  id Int     @id @default(autoincrement()) @map("id")
  codigo String @map("codigo")
  codigoNormalizado String @map("codigo_normalizado")
  descripcion String? @map("descripcion")
  texto String? @map("texto")
  vigente Boolean @default(true) @map("vigente")

  normaId Int @map("norma_id")
  norma   dim_norma @relation(fields: [normaId], references: [id], onDelete: Cascade)

  sanciones fact_sancion_articulo[]

  @@unique([normaId, codigoNormalizado])
  @@index([normaId])
  @@map("dim_articulo")
}

model dim_incidencia_licencia {
  id Int    @id @default(autoincrement()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @unique @map("nombre")
  orden Int    @default(0) @map("orden")

  detalle   dim_detalle_incidencia[]
  sanciones fact_sancion[]

  @@index([orden])
  @@map("dim_incidencia_licencia")
}

model dim_detalle_incidencia {
  id Int                     @id @default(autoincrement()) @map("id")
  codigo String                  @unique @map("codigo")
  /// No es unico: un mismo detalle puede darse bajo varias incidencias de
  /// licencia ("UNIFORMES" aparece en DEPORTIVA, ADMINISTRATIVA e
  /// INFRAESTRUCTURA). La unicidad va por el par incidencia + detalle.
  nombre String                  @map("nombre")
  orden Int                     @default(0) @map("orden")
  incidenciaId Int @map("incidencia_id")
  incidencia   dim_incidencia_licencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)

  sanciones fact_sancion[]

  @@unique([incidenciaId, nombre])
  @@index([incidenciaId])
  @@map("dim_detalle_incidencia")
}

/// Tasa de conversiÃ³n Unidad Convertible -> USD (BCV), con vigencia.
model dim_tasa_uc {
  id Int      @id @default(autoincrement()) @map("id")
  fechaVigencia DateTime @unique @db.Date @map("fecha_vigencia")
  valorUcUsd Decimal  @db.Decimal(18, 6) @map("valor_uc_usd")
  fuente String? @map("fuente")
  notas String? @map("notas")

  multas fact_admin_multa[]

  @@index([fechaVigencia])
  @@map("dim_tasa_uc")
}

// =============================================================================
// HECHOS
// =============================================================================

/// Partido del calendario. Grano: un encuentro.
model fact_partido {
  id Int       @id @default(autoincrement()) @map("id")
  /// `ID Encuentro CDH` (ej. 2025-0001)
  cdhId String?   @unique @map("cdh_id")
  /// `Id_Partido` de la data
  idPartido String? @map("id_partido")
  /// `PARTIDO`: texto libre "A VS. B"
  descripcion String @map("descripcion")
  local String? @map("local")
  visitante String? @map("visitante")
  marcador String? @map("marcador")
  fechaActa DateTime? @db.Date @map("fecha_acta")
  numeroActa String? @map("numero_acta")
  acta String? @map("acta")
  numeroJornada String? @map("numero_jornada")
  suspendido Boolean   @default(false) @map("suspendido")
  observaciones String? @map("observaciones")

  fechaId Int? @map("fecha_id")
  fecha         dim_fecha?     @relation(fields: [fechaId], references: [id], onDelete: SetNull)
  torneoId Int? @map("torneo_id")
  torneo        dim_torneo?    @relation(fields: [torneoId], references: [id], onDelete: SetNull)
  categoriaId Int? @map("categoria_id")
  categoria     dim_categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  faseId Int? @map("fase_id")
  fase          dim_fase?      @relation(fields: [faseId], references: [id], onDelete: SetNull)
  rondaId Int? @map("ronda_id")
  ronda         dim_ronda?     @relation(fields: [rondaId], references: [id], onDelete: SetNull)
  jornadaId Int? @map("jornada_id")
  jornada       dim_jornada?   @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  localId Int? @map("local_id")
  localClub     dim_club?      @relation("partido_local", fields: [localId], references: [id], onDelete: SetNull)
  visitanteId Int? @map("visitante_id")
  visitanteClub dim_club?      @relation("partido_visitante", fields: [visitanteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sanciones  fact_sancion[]
  incidentes fact_expediente_partido[]

  @@index([torneoId, categoriaId, jornadaId])
  @@index([fechaId])
  @@index([localId])
  @@index([visitanteId])
  @@index([descripcion])
  @@map("fact_partido")
}

/// SanciÃ³n / incidencia de acta disciplinaria.
/// Grano: una fila de la hoja `DATA`.
model fact_sancion {
  id BigInt  @id @default(autoincrement()) @map("id")
  /// Hash del contenido de origen: idempotencia de la ingesta.
  hashOrigen String  @unique @map("hash_origen")
  origenFila Int? @map("origen_fila")
  origenArchivo String? @map("origen_archivo")
  origenGid String? @map("origen_gid")

  fecha DateTime @db.Date @map("fecha")

  personaId Int? @map("persona_id")
  clubId Int? @map("club_id")

  /// PARTIDOS/JORNADAS de sanciÃ³n.
  sanctionJuegos Int? @map("sanction_juegos")
  /// DuraciÃ³n en dÃ­as, para suspensiones calendarizadas.
  sanctionDias Int? @map("sanction_dias")
  /// Monto en Unidad Convertible.
  multaUc Decimal? @db.Decimal(18, 4) @map("multa_uc")
  /// Monto convertido a USD con dim_tasa_uc.
  multaUsd Decimal? @db.Decimal(18, 2) @map("multa_usd")
  tasaUsd Decimal? @db.Decimal(18, 6) @map("tasa_usd")

  reintegro Boolean @default(false) @map("reintegro")
  alertaSuspension Boolean @default(false) @map("alerta_suspension")
  /// ComisiÃ³n que resolviÃ³.
  proc String? @map("proc")
  /// Texto crudo de cada columna de la hoja, para trazabilidad y reproceso.
  motivoRaw String? @map("motivo_raw")
  observacionRaw String? @map("observacion_raw")
  detalleIncidenciaRaw String? @map("detalle_incidencia_raw")
  articulosRaw String? @map("articulos_raw")
  normaRaw String? @map("norma_raw")
  nombreRaw String? @map("nombre_raw")
  cedulaRaw String? @map("cedula_raw")
  /// Marca "N/A" en columnas numÃ©ricas.
  esNulo Boolean @default(false) @map("es_nulo")

  fechaId Int? @map("fecha_id")
  fechaDim            dim_fecha?               @relation(fields: [fechaId], references: [id], onDelete: SetNull)
  torneoId Int? @map("torneo_id")
  torneo              dim_torneo?              @relation(fields: [torneoId], references: [id], onDelete: SetNull)
  categoriaId Int? @map("categoria_id")
  categoria           dim_categoria?           @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  faseId Int? @map("fase_id")
  fase                dim_fase?                @relation(fields: [faseId], references: [id], onDelete: SetNull)
  rondaId Int? @map("ronda_id")
  ronda               dim_ronda?               @relation(fields: [rondaId], references: [id], onDelete: SetNull)
  jornadaId Int? @map("jornada_id")
  jornada             dim_jornada?             @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  partidoId Int? @map("partido_id")
  partido             fact_partido?            @relation(fields: [partidoId], references: [id], onDelete: SetNull)
  tipoSancionadoId Int? @map("tipo_sancionado_id")
  tipoSancionado      dim_tipo_sancionado?     @relation(fields: [tipoSancionadoId], references: [id], onDelete: SetNull)
  tipoDecisionId Int? @map("tipo_decision_id")
  tipoDecision        dim_tipo_decision?       @relation(fields: [tipoDecisionId], references: [id], onDelete: SetNull)
  motivoId Int? @map("motivo_id")
  motivo              dim_motivo?              @relation(fields: [motivoId], references: [id], onDelete: SetNull)
  tipoInfraccionId Int? @map("tipo_infraccion_id")
  tipoInfraccion      dim_tipo_infraccion?     @relation(fields: [tipoInfraccionId], references: [id], onDelete: SetNull)
  observacionId Int? @map("observacion_id")
  observacion         dim_observacion?         @relation(fields: [observacionId], references: [id], onDelete: SetNull)
  normaId Int? @map("norma_id")
  norma               dim_norma?               @relation(fields: [normaId], references: [id], onDelete: SetNull)
  incidenciaId Int? @map("incidencia_id")
  incidencia          dim_incidencia_licencia? @relation(fields: [incidenciaId], references: [id], onDelete: SetNull)
