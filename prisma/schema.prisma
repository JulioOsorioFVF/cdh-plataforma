model fact_expediente {
  id Int              @id @default(autoincrement()) @map("id")
  /// `N Exp` del CUADRO DE EXPEDIENTES ("001"). El numero se REUTILIZA cada
  /// ano (001 existe en 2022..2026), asi que la clave natural es la pareja
  /// con `anio`, que se expresa como "001/2022".
  numero String @map("numero")
  anio Int @map("anio")
  /// `Asunto de Exp` / `Nombre dado al Expediente`.
  nombre String? @map("nombre")
