  CUERPO_TECNICO             // Protestas airadas, expulsiÃ³n DT/asistentes
  INFRAESTRUCTURA_CAMERINOS  // Camerinos de Ã¡rbitros, terreno de juego, iluminaciÃ³n
  FUERZA_PUBLICA_SEGURIDAD   // Fuerza pÃºblica insuficiente, invasiÃ³n de cancha, violencia
  PROTOCOLO_MATERIAL         // Balones, recogepelotas, retraso de inicio, ambulancia
  DOCUMENTACION_ALINEACION   // AlineaciÃ³n indebida, usurpaciÃ³n de identidad, COMET
  FINANCIERA_ARBITRAJE       // Falta de pago de honorarios/viÃ¡ticos arbitrales, deudas
  INTEGRIDAD_AMANO           // ManipulaciÃ³n de partidos / infracciÃ³n Ã©tica
}

// 1. Cabecera del Acta Disciplinaria por Jornada y Torneo (471 jornadas / 30 torneos)
model ActaDisciplinariaJornada {
  id                  Int                     @id @default(autoincrement())
  codigoActa          String                  @unique @map("codigo_acta") // Ej: "ACTA-FUTVE1-2026-J12"
  anio                Int
  semestre            String                  // "2025-2" | "2026-1" | "2026-2"
  torneo              String                  // Liga FUTVE, Liga FUTVE 2, Futsal 1, Junior, etc.
  jornadaNumero       Int                     @map("jornada_numero")
  partidosAnalizados  Int                     @default(0) @map("partidos_analizados")
  juezUnicoPonente    String                  @map("juez_unico_ponente")
  especialistaLegal   String                  @map("especialista_legal")
  analistaAsignado    String                  @map("analista_asignado")
  totalMultasUcfvf    Decimal                 @default(0) @map("total_multas_ucfvf")
  totalMultasUsd      Decimal                 @default(0) @map("total_multas_usd")
  estadoActa          String                  @default("BORRADOR_IA") @map("estado_acta") // BORRADOR_IA | REVISADA | PUBLICADA
  fechaSesionCdh      DateTime?               @map("fecha_sesion_cdh")
  incidencias         IncidenciaActaPartido[]
  creadoEn            DateTime                @default(now()) @map("creado_en")

  @@index([torneo, anio, jornadaNumero])
  @@map("acta_disciplinaria_jornada")
}

// 2. Detalle de cada incidencia extraÃ­da de Informes de Ãrbitros y Delegados
model IncidenciaActaPartido {
  id                    Int                      @id @default(autoincrement())
  actaId                Int                      @map("acta_id")
  acta                  ActaDisciplinariaJornada @relation(fields: [actaId], references: [id], onDelete: Cascade)
  partido               String                   // Ej: "Centauros de Caracas vs Bambi Futsal"
  fechaPartido          DateTime?                @map("fecha_partido")
  origen                OrigenIncidenciaPartido
  categoria             CategoriaIncidencia
  lugarIncidencia       String?                  @map("lugar_incidencia") // Campo de juego, Camerinos, Camerinos de Ãrbitros, Tribuna
  motivoEstandarizado   String                   @map("motivo_estandarizado") // Ej: "ACUMULACIÃ“N 4 AMARILLAS", "FUERZA PÃšBLICA INSUFICIENTE"
  clubInvolucrado       String                   @map("club_involucrado")
  sujetoSancionado      String                   @map("sujeto_sancionado")
  tipoSujeto            String                   @map("tipo_sujeto") // CLUB | JUGADOR | CUERPO_TECNICO | OFICIAL_PARTIDO
  cedulaOCometId        String?                  @map("cedula_o_comet_id")
  extractoInformeBruto  String                   @map("extracto_informe_bruto")
  articulosRdfvf        String[]                 @map("articulos_rdfvf")
  tipoSancion           String                   @map("tipo_sancion") // ADVERTENCIA | AMONESTACION | SUSPENSION | MULTA | EXPULSION
  partidosSuspension    Int                      @default(0) @map("partidos_suspension")
  multaUcfvf            Decimal                  @default(0) @map("multa_ucfvf")
  multaUsd              Decimal                  @default(0) @map("multa_usd")
  esReincidente         Boolean                  @default(false) @map("es_reincidente")
  derivaEnExpediente    Boolean                  @default(false) @map("deriva_en_expediente")
  confianzaExtraccionIA Float                    @default(1.0) @map("confianza_extraccion_ia")

  @@index([clubInvolucrado, motivoEstandarizado])
  @@index([sujetoSancionado, tipoSancion])
  @@map("incidencia_acta_partido")
}

// 3. Feature Store de Sujetos Disciplinarios (Para cÃ¡lculo instantÃ¡neo de Reincidencia y Solvencia)
model HistorialDisciplinarioSujeto {
  id                       Int      @id @default(autoincrement())
  identificadorUnico       String   @unique @map("identificador_unico") // COMET ID o Slug Normalizado
  nombreCompleto           String   @map("nombre_completo")
  tipoSujeto               String   @map("tipo_sujeto") // CLUB | JUGADOR | CUERPO_TECNICO | DIRIGENTE
  clubActual               String?  @map("club_actual")
  torneoPrincipal          String?  @map("torneo_principal")
  amarillasAcumuladasCiclo Int      @default(0) @map("amarillas_acumuladas_ciclo")
  rojasAcumuladasCiclo     Int      @default(0) @map("rojas_acumuladas_ciclo")
  expedientesAbiertos      Int      @default(0) @map("expedientes_abiertos")
  sancionesHistoricas      Int      @default(0) @map("sanciones_historicas")
  multasAcumuladasUcfvf    Decimal  @default(0) @map("multas_acumuladas_ucfvf")
  deudaPendienteUsd        Decimal  @default(0) @map("deuda_pendiente_usd")
  solventeLicenciaClubes   Boolean  @default(true) @map("solvente_licencia_clubes")
  indiceRiesgoReincidencia Float    @default(0.0) @map("indice_riesgo_reincidencia") // Score ML 0.0 a 1.0
  actualizadoEn            DateTime @updatedAt @map("actualizado_en")

  @@index([clubActual, solventeLicenciaClubes])
  @@map("historial_disciplinario_sujeto")
}

// 4. Memoria Vectorial de Jurisprudencia CDH-FVF y Normativa (RAG con pgvector 768 dimensiones)
model MemoriaJuridicaVectorial {
  id                  Int                        @id @default(autoincrement())
  tipoDocumento       String                     @map("tipo_documento") // DECISION_CDH | REFERENCIA_CDH | ARTICULO_RDFVF | CODIGO_FIFA | LAUDO_TAS
  codigoReferencia    String                     @unique @map("codigo_referencia") // Ej: "EXP-048-2025" o "RDFVF-ART-170"
  anio                Int
  torneo              String?
  motivoTipificado    String                     @map("motivo_tipificado")
  articulosClave      String[]                   @map("articulos_clave")
  extractoHechos      String                     @map("extracto_hechos")
  criterioJuridico    String                     @map("criterio_juridico") // Ratio decidendi / Dispositiva
  multaAplicadaUcfvf  Decimal                    @default(0) @map("multa_aplicada_ucfvf")
  sancionDeportiva    String?                    @map("sancion_deportiva")
  metadatosJson       Json                       @map("metadatos_json")
  embedding           Unsupported("vector(768)")?
  creadoEn            DateTime                   @default(now()) @map("creado_en")

  @@index([tipoDocumento, motivoTipificado])
  @@map("memoria_juridica_vectorial")
}
// ============================================================================
// EXTENSIÓN AVANZADA CDH-FVF: PLAYBOOKS, AUDIENCIAS, CAUTELARES Y FACTURACIÓN
// ============================================================================

// 1. Catálogo de Procedimientos y Pasos Obligatorios (El "Cerebro Normativo" del Agente IA)
model PlantillaProcedimientoCDH {
  id                        Int      @id @default(autoincrement())
  codigoTipologia           String   @unique @map("codigo_tipologia") // EJECUCION_CRD | INTEGRIDAD_AMANO | REDES_SOCIALES_ARBITROS | REMISION_JUEZ_UNICO | VIOLENCIA_MENORES_LOPNNA | ACTA_JORNADA
  nombreProcedimiento       String   @map("nombre_procedimiento")
  articulosBase             String[] @map("articulos_base")
  documentosRequeridos      String[] @map("documentos_requeridos")    // Checklist de admisibilidad/certidumbre
  lapsoDescargosDias        Int      @default(5) @map("lapso_descargos_dias")
  tipoDiasDescargos         String   @default("HABILES") @map("tipo_dias_descargos") // HABILES | CONTINUOS
  lapsoCumplimientoDias     Int      @default(30) @map("lapso_cumplimiento_dias")
  requiereAudiencia         Boolean  @default(false) @map("requiere_audiencia")
  unidadesNotificarInicio   String[] @map("unidades_notificar_inicio")
  unidadesNotificarDecision String[] @map("unidades_notificar_decision")
  pasosJson                 Json     @map("pasos_json")               // Máquina de estados paso a paso
  preguntasBaseInterrogatorio Json?  @map("preguntas_base_interrogatorio")
  creadoEn                  DateTime @default(now()) @map("creado_en")

  @@map("plantilla_procedimiento_cdh")
}

// 2. Audiencias e Interrogatorios (Presenciales o Google Meet - Art. 173.5 y 174 RD-FVF)
model AudienciaInterrogatorio {
  id                    Int                     @id @default(autoincrement())
  expedienteId          Int                     @map("expediente_id")
  expediente            ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  comparecienteNombre   String                  @map("compareciente_nombre")
  comparecienteCedula   String?                 @map("compareciente_cedula")
  rolCompareciente      String                  @map("rol_compareciente") // INVESTIGADO | TESTIGO_PRESENCIAL | TESTIGO_PARTICIPANTE | VICTIMA_MENOR | OFICIAL_PARTIDO | AGENTE_POLICIAL
  abogadoAsistente      String?                 @map("abogado_asistente") // Ej: IPSA / Inpreabogado
  modalidad             String                  @default("TELEMATICA_MEET") // PRESENCIAL_SEDE_FVF | TELEMATICA_MEET
  enlaceMeet            String?                 @map("enlace_meet")
  fechaProgramada       DateTime                @map("fecha_programada")
  reprogramada          Boolean                 @default(false)
  motivoReprogramacion  String?                 @map("motivo_reprogramacion")
  estadoAudiencia       String                  @default("CITADA") @map("estado_audiencia") // CITADA | REPROGRAMADA | CELEBRADA | INCOMPARECENCIA
  pliegoPreguntasRespuestas Json                @map("pliego_preguntas_respuestas") // Array de { numero, pregunta, respuesta, contradiccionDetectadaIA }
  lapsoPruebasExtraDias Int?                    @map("lapso_pruebas_extra_dias") // Ej: 3 días post-audiencia (Exp. 051/26)
  actaFirmadaUrl        String?                 @map("acta_firmada_url")
  creadoEn              DateTime                @default(now()) @map("creado_en")

  @@index([expedienteId, fechaProgramada])
  @@map("audiencia_interrogatorio")
}

// 3. Control de Medidas Cautelares / Inhabilitaciones Preventivas (Alerta Art. 30 RD-FVF: Máx 30 días continuos)
model MedidaCautelarDisciplinaria {
  id                      Int                     @id @default(autoincrement())
  expedienteId            Int                     @map("expediente_id")
  expediente              ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  sujetoAfectado          String                  @map("sujeto_afectado")
  cedulaSujeto            String?                 @map("cedula_sujeto")
  cargoRol                String                  @map("cargo_rol")
  tipoMedida              String                  @map("tipo_medida") // INHABILITACION_PREVENTIVA | SUSPENSION_PROVISIONAL | PROHIBICION_ACCESO_ESTADIO
  dictadaPor              String                  @map("dictada_por") // JUEZ_UNICO | PLENO_CDH
  fechaInicio             DateTime                @map("fecha_inicio")
  diasMaximosLegales      Int                     @default(30) @map("dias_maximos_legales") // Art. 30 RD-FVF = 30 días continuos
  fechaVencimientoFatal   DateTime                @map("fecha_vencimiento_fatal")
  estadoMedida            String                  @default("VIGENTE") @map("estado_medida") // VIGENTE | LEVANTADA | VENCIDA_ART_30 | ABSORBIDA_EN_DECISION
  descontarDeSancionFinal Boolean                 @default(true) @map("descontar_de_sancion_final")

  @@index([estadoMedida, fechaVencimientoFatal])
  @@map("medida_cautelar_disciplinaria")
}

// 4. Ciclo Completo de Facturación Fiscal y Solvencia (CDH <-> UCA <-> Administración FVF)
model FacturacionMultaFVF {
  id                      Int                     @id @default(autoincrement())
  expedienteId            Int                     @map("expediente_id")
  expediente              ExpedienteDisciplinario @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  numeroDecision          String                  @map("numero_decision") // Ej: "046/2026" o "032/2026"
  sancionadoNombre        String                  @map("sancionado_nombre")
  rifSancionado           String?                 @map("rif_sancionado")  // Ej: "V302982186" (Requisito SENIAT/Admin)
  correoFacturacion       String?                 @map("correo_facturacion")
  telefonoContacto        String?                 @map("telefono_contacto")
  multaUcfvf              Decimal                 @map("multa_ucfvf")
  multaUsd                Decimal                 @map("multa_usd")
  tasaCambioBs            Decimal?                @map("tasa_cambio_bs")  // Ej: 742.2292 (Exp. 003/26)
  montoPagadoBs           Decimal?                @map("monto_pagado_bs")
  referenciasBancarias    String[]                @map("referencias_bancarias") // ["736802742", "428503188"]
  reportadoEnFormUca      Boolean                 @default(false) @map("reportado_en_form_uca")
  numeroFacturaFiscal     String?                 @map("numero_factura_fiscal") // Ej: "A00000993" o "A000000768"
  numeroControlFiscal     String?                 @map("numero_control_fiscal") // Ej: "00-00001345"
  estadoCobranza          String                  @default("PENDIENTE_DATOS_RIF") @map("estado_cobranza") // PENDIENTE_DATOS_RIF | EN_CONCILIACION_UCA | FACTURADO_CANCELADO
  requiereCursoIntegridad Boolean                 @default(false) @map("requiere_curso_integridad")
  cursoIntegridadCumplido Boolean                 @default(false) @map("curso_integridad_cumplido")
  fechaCursoIntegridad    DateTime?               @map("fecha_curso_integridad")
  referenciaClausuraCdh   String?                 @map("referencia_clausura_cdh") // Ej: "Ref. 098/2026" o "Ref. 035/2026"
  actualizadoEn           DateTime                @updatedAt @map("actualizado_en")

  @@index([estadoCobranza, numeroFacturaFiscal])
  @@map("facturacion_multa_fvf")
}

// 5. Acumulador de Advertencias a Clubes en Actas de Justicia (Ej: 1ª a 13ª Advertencia DT Exclusivo, Médico, Wifi, Cercado)
model ContadorAdvertenciaClub {
  id                  Int      @id @default(autoincrement())
  club                String
  torneo              String
  categoria           String   // Ej: "Sub-15", "Sub-16", "Primera División"
  motivoAdvertencia   String   @map("motivo_advertencia") // FALTA_MEDICO | FALTA_DT_EXCLUSIVO | VESTUARIO_ARBITRAL_WIFI | CERCADO_PERIMETRAL | SEGURIDAD_BARRAS
  articulosInfringidos String  @map("articulos_infringidos") // Ej: "Arts. 39 y 43 Normas Reguladoras Liga FUTVE Junior"
  cantidadAcumulada   Int      @default(1) @map("cantidad_acumulada")
  ultimaJornada       Int      @map("ultima_jornada")
  derivaEnMulta       Boolean  @default(false) @map("deriva_en_multa")
  actualizadoEn       DateTime @updatedAt @map("actualizado_en")

  @@unique([club, torneo, categoria, motivoAdvertencia], name: "club_torneo_adv_unico")
  @@map("contador_advertencia_club")
}